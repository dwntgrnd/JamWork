# ── Database ───────────────────────────────────────────────
# Local dev (Docker): use 127.0.0.1 (not "localhost") for TCP connection
# Production (SiteGround): use "localhost" — MySQL runs on same server
DB_HOST=127.0.0.1
DB_NAME=jamwork
DB_USER=
DB_PASS=
DB_PORT=3306

# ── Authentication ─────────────────────────────────────────
# MUST be a strong random string in production (min 32 chars)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_EXPIRY=30d

# ── Email (SMTP) ──────────────────────────────────────────
# Production: SiteGround email on subdomain
# Host: mail.jamwork.alchemyk12.com (or SiteGround's SMTP server)
# Port: 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JamWork

# ── Application ────────────────────────────────────────────
# APP_URL: full URL of the frontend (used in email templates for links)
# Local dev: http://localhost:5173
# Production: https://jamwork.alchemyk12.com
APP_URL=http://localhost:5173
APP_ENV=development
