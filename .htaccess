# JamWork v2 — Root .htaccess
# Subdomain document root: SPA frontend + /api/ subdirectory

RewriteEngine On

# ── Install gate ─────────────────────────────────────────
# If not installed, route all requests to the installer
RewriteCond %{DOCUMENT_ROOT}/api/.installed !-f
RewriteCond %{REQUEST_URI} !^/api/install\.php [NC]
RewriteCond %{REQUEST_URI} !^/api/install-assets/ [NC]
RewriteRule ^ /api/install.php [L]

# ── API passthrough ───────────────────────────────────────
# Let /api/ requests fall through to api/.htaccess
RewriteRule ^api/ - [L]

# ── SPA fallback routing ──────────────────────────────────
# If not a real file or directory, serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# ── Security headers ─────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "0"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ── Compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Cache headers for Vite hashed assets ─────────────────
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
