# NOTE: api/vendor/ and client/dist/ are intentionally tracked.
# They ship as part of the distribution so deployers don't need
# CLI tools (composer, node). Developers: run `composer install`
# and `npm run build` as usual — your local copies will match.

# Dependencies
node_modules/
client/node_modules/

# Environment files
.env
api/.env

# Installer lock file
api/.installed

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Docker
docker-compose.override.yml

# Local dev docs
DEV-SETUP.md

# Operational / local-only — specific to this instance's deployments, not part
# of the release package others consume. Includes the per-version runbooks: they
# name this instance's prod host, owner email, and secured endpoints (recon value
# in a public repo), so they are kept local going forward.
docs/production-update-runbook.md
docs/production-update-runbook-v*.md
docs/cc-prompts/

# Internal planning/design docs — kept out of the public repo and release package.
# History is preserved; these are dropped from the index going forward.
docs/audits/
docs/plans/
docs/specs/
docs/superpowers/

# Production env (real credentials — never commit)
api/.env.production

# Claude Code
.claude/

# Release build output
release/

# Generated email preview artifacts (scripts/preview-report-email.php)
report-email-preview.html
report-email-preview.txt
